{
  "name": "pixi-gomoku",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "五子棋 · PixiJS game with SVG-drawn UI, AI opponents, online rooms and a chest-opening result screen.",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "peerjs": "^1.5.5",
    "pixi.js": "^8.21.0"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
